# ─────────────────────────────────────────────────────────────────────
# PRSense environment — copy to `.env` and fill in. NEVER commit `.env`.
# Every service below has a genuinely free tier (no card required).
# ─────────────────────────────────────────────────────────────────────

# --- App ---
APP_ENV=local                       # local | production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# --- GitHub ---
# Fine-grained PAT (github.com/settings/tokens) with: Pull requests (RW),
# Contents (RO), Metadata (RO). Free.
GITHUB_TOKEN=
# Shared secret you set on the repo webhook config; used to verify HMAC sig.
GITHUB_WEBHOOK_SECRET=

# --- LLMs (free tiers) ---
# Gemini: https://aistudio.google.com/apikey  (~1500 req/day free)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Groq: https://console.groq.com/keys  (generous free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Storage ---
# Local dev default: SQLite file. Leave DATABASE_URL blank to use it.
DATABASE_URL=
SQLITE_PATH=./data/prsense.db
# Supabase free tier (optional, for deployment): Project Settings > Database
SUPABASE_URL=
SUPABASE_KEY=

# --- Vector store (local, free) ---
CHROMA_PERSIST_DIR=./data/chroma

# --- Tracing (LangSmith free tier) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=prsense
